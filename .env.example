# Copy to .env.local and fill in once the proxy is deployed (see supabase/README.md).
# None of these are secrets: the model and voice keys live on the proxy.
EXPO_PUBLIC_ATTEND_API_URL=https://<project-ref>.supabase.co/functions/v1/attend
EXPO_PUBLIC_ATTEND_API_KEY=<supabase anon / publishable key>
# Optional: ElevenLabs voice (default: River, SAz9YHcvj6GT2YYXdXww)
# EXPO_PUBLIC_ELEVENLABS_VOICE_ID=
