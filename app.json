{
  "expo": {
    "name": "Attend",
    "slug": "attend",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "attend",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F7F5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.itaiagami.attend",
      "appleTeamId": "WZ6VU6BWNG",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSPhotoLibraryUsageDescription": "Attend doesn't access your photo library."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeHealth",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.itaiagami.attend",
      "adaptiveIcon": {
        "backgroundColor": "#F3F3F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#050606",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Attend's guided practices only play audio and never use the microphone. Attend asks only in an optional voice mode, where your words are recognized on this iPhone and audio is never saved.",
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Attend's guided practices only play audio and never use the microphone. Attend asks only in an optional voice mode, where your words are recognized on this iPhone and audio is never saved.",
          "speechRecognitionPermission": "Attend's guided practices never listen. Speech is recognized only in an optional voice mode, on this iPhone, and audio is never saved."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "itai26",
    "extra": {
      "eas": {
        "projectId": "86b5b6c3-8a3c-42ed-8eb1-d8f22d45fb27"
      }
    }
  }
}
